# PostHog browser configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Resend, which emails what the forms send. Server only: never give these a
# NEXT_PUBLIC_ name. wavemetrik.com has to be verified in Resend.
RESEND_API_KEY=your_resend_api_key_here
# The mailbox that receives the forms. Defaults to support@wavemetrik.com.
RESEND_TO=someone@wavemetrik.com
# The address they come from. Defaults to support@wavemetrik.com.
# RESEND_FROM=support@wavemetrik.com
